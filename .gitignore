# Publish source and reviewed deliverables only.
/*
!/.gitignore
!/README.md
!/app/
!/docs/
!/scripts/
!/output/
/output/*
!/output/pdf/
!/output/web-acceptance/
/output/web-acceptance/*
!/output/web-acceptance/04-dual-home.png
!/output/web-acceptance/06-consult.png
!/output/web-acceptance/07-product-draft.png
/docs/*
!/docs/PRD.md
!/docs/开发计划.md
!/docs/开发日志.md
!/docs/作品说明书.md
!/docs/演示脚本.md
!/docs/提交材料清单.md
!/docs/统筹检查记录.md
**/node_modules/
**/.env*
**/data/private/
**/.next*/
**/tmp/
**/*.log
**/*.tsbuildinfo
