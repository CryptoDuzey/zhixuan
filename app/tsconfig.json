{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-parallel/types/**/*.ts",
    ".next-parallel/dev/types/**/*.ts",
    ".next-cache/types/**/*.ts",
    ".next-cache/dev/types/**/*.ts",
    ".next-experience/types/**/*.ts",
    ".next-experience/dev/types/**/*.ts",
    ".next-design/types/**/*.ts",
    ".next-design/dev/types/**/*.ts",
    ".next-product/types/**/*.ts",
    ".next-product/dev/types/**/*.ts",
    ".next-length/types/**/*.ts",
    ".next-length/dev/types/**/*.ts",
    ".next-length-2/types/**/*.ts",
    ".next-length-2/dev/types/**/*.ts",
    ".next-restored/types/**/*.ts",
    ".next-restored/dev/types/**/*.ts",
    ".next-window/types/**/*.ts",
    ".next-window/dev/types/**/*.ts",
    ".next-split/types/**/*.ts",
    ".next-split/dev/types/**/*.ts",
    ".next-split-final/types/**/*.ts",
    ".next-split-final/dev/types/**/*.ts",
    ".next-demo/types/**/*.ts",
    ".next-demo/dev/types/**/*.ts",
    ".next-demo-final/types/**/*.ts",
    ".next-demo-final/dev/types/**/*.ts",
    ".next-roadshow/types/**/*.ts",
    ".next-roadshow/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests",
    ".next-build"
  ]
}
